# Copy this file to .env.local for local development.
# In production, set these as environment variables on your hosting provider
# (e.g. Vercel: Project Settings -> Environment Variables). Never commit real
# values - .env.local is already git-ignored.

# The password used to log into /admin. Pick something you don't use anywhere else.
ADMIN_PASSWORD=

# Random secret used to sign the admin login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# A GitHub Personal Access Token (fine-grained, scoped to ONLY this repo,
# with "Contents: Read and write" permission and nothing else). The admin
# panel uses this to commit new/edited blog posts directly to the repo.
# Create one at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional - defaults shown below, only set if different.
# GITHUB_REPO=kamrulteam6-hash/stroop-effect-test
# GITHUB_BRANCH=main
